# Name/phone and bilingual release: see BRANCH_NOTES.md for hosted readiness.
# Apply the reviewed migration and enable Anonymous Sign-Ins before field entry.
# Server-only credentials. Never use NEXT_PUBLIC_ for secrets.
OPENAI_API_KEY=
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_REPORT_MODEL=gpt-4.1-mini
# Provider switch. Keep all activation flags false until the reviewed AWS
# infrastructure and Supabase migration are deployed and a real test succeeds.
AI_PROVIDER=openai
AWS_PROCESSING_ENABLED=false
ROCKWOOD_AWS_REGION=us-east-1
AWS_BEDROCK_MODEL_ID=us.amazon.nova-2-lite-v1:0
# Vercel Production only: short-lived OIDC role (no long-lived AWS access keys).
AWS_ROLE_ARN=
# Lambda worker only; staging bucket and existing server key in Secrets Manager.
AWS_TRANSCRIBE_BUCKET=
# Lambda-only role trusted by Transcribe, restricted to private staging jobs.
AWS_TRANSCRIBE_DATA_ROLE_ARN=
ROCKWOOD_SERVER_SECRET_ARN=
# Keep disabled for public demos. Enable only in a trusted/restricted environment.
LIVE_AI_ENABLED=false
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Required for an HTTPS phone tunnel in Live mode; exact origins, comma separated.
ALLOWED_ORIGINS=http://localhost:8791,http://127.0.0.1:8791
# Report workflow: configure these only on the trusted server, never NEXT_PUBLIC_.
REPORT_DELIVERY_ENABLED=false
APP_URL=
SUPABASE_SECRET_KEY=
# Testing sender is fixed to rockwoodrocky1@gmail.com. Use a Google app password.
GMAIL_APP_PASSWORD=
# Optional future transactional email provider; Gmail takes precedence when set.
RESEND_API_KEY=
REPORT_EMAIL_FROM=
# Set ses only after the final sender is verified; leave disabled for skeleton setup.
REPORT_EMAIL_PROVIDER=disabled
# ISO timestamp: older queued reports get a PDF but are held before email.
REPORT_EMAIL_NOT_BEFORE=2099-01-01T00:00:00.000Z
CRON_SECRET=

# Enable after the Projects /cam route and its database migrations are deployed.
WORKSPACE_CAM_ENABLED=false
